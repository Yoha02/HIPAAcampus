# The frontend defaults to this value.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Trusted local doctor identity. Never accept this from browser/model arguments.
HIPAACAMPUS_DOCTOR_ID=doc-nguyen
HIPAACAMPUS_MODEL_MODE=local
HIPAACAMPUS_BTE_MODE=live
BTE_TRAPI_URL=https://api.bte.ncats.io/v1/query

# Optional live AWS Bedrock mode. Use the workshop-provided model identifier.
# HIPAACAMPUS_MODEL_MODE=bedrock
# BEDROCK_MODEL_ID=
# AWS_REGION=us-west-2

# Optional if the deployed BTE endpoint requires a token.
# BTE_API_KEY=

# Existing local whisper.cpp configuration.
WHISPER_SERVER_URL=http://127.0.0.1:8178
WHISPER_MODEL=base.en
WHISPER_LANGUAGE=en
